{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ai-services": {
      "root": "ai-services",
      "framework": "fastapi",
      "entrypoint": "main:app"
    },
    "archive": {
      "root": "archive",
      "runtime": "node",
      "entrypoint": "index.js"  // <-- Add this line (replace "index.js" with your actual main file)
    },
    "backend": {
      "root": "backend",
      "framework": "express"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
